<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>QLST5 - jsp-servlet-jdbc-mysql supermarket</display-name>

  <!-- Servlet va Filter khai bao bang annotation (@WebServlet, @WebFilter) trong goi net.qlst.supermarket.web -->

  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <!-- khai bao san page directive va thu vien JSTL (c, fmt, fn) cho moi trang JSP -->
      <include-prelude>/WEB-INF/prelude.jspf</include-prelude>
    </jsp-property-group>
    <!-- cac doan include (header.jspf, footer.jspf, ...) cung luu UTF-8 -->
    <jsp-property-group>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
    </jsp-property-group>
  </jsp-config>

  <!-- UpdateProductGUI5.jsp co o inoutImage : file (Hinh 3, Hinh 4) => doUpdateProduct5.jsp nhan multipart/form-data -->
  <servlet>
    <servlet-name>doUpdateProduct5</servlet-name>
    <jsp-file>/view/warehouse/doUpdateProduct5.jsp</jsp-file>
    <multipart-config>
      <max-file-size>5242880</max-file-size>
      <max-request-size>6291456</max-request-size>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>doUpdateProduct5</servlet-name>
    <url-pattern>/view/warehouse/doUpdateProduct5.jsp</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Giong bai LAB: Error.jsp hien thong bao loi -->
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/Error.jsp</location>
  </error-page>
</web-app>
